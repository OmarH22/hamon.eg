# ---------------------------------------------------------------------------
# HAMON — environment variables
# Copy to .env.local for development, and set the same values in your host.
# Never commit real values. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# --- SERVER ONLY (never sent to the browser) -------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
# Deliberately NOT prefixed with NEXT_PUBLIC_: the browser never calls Supabase
# directly, every write goes through this app's API routes.
SUPABASE_URL=

# Supabase service-role key (Project settings > API > service_role).
# Full database access — server only, never expose it, never prefix it with
# NEXT_PUBLIC_. Rotate it immediately if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=

# Password for /admin. Minimum 8 characters; use something long and random.
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Minimum 16 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- PUBLIC (bundled into the browser — nothing secret here) ---------------

# Meta Pixel ID. Leave empty to disable the pixel entirely (no script loads).
NEXT_PUBLIC_META_PIXEL_ID=

# Canonical site URL, used for metadata, Open Graph, robots.txt and sitemap.
# On Render you can leave this blank at first: the app falls back to Render's own
# RENDER_EXTERNAL_URL. Set it to your final domain and redeploy so the Open Graph
# image URL is baked in correctly.
NEXT_PUBLIC_SITE_URL=

# Optional label stored with every response, so you can compare page versions.
# A ?variant= query parameter on the landing URL overrides it per visit.
NEXT_PUBLIC_LANDING_VARIANT=v1
